# Linux clangd can fail to build the Apple SDK's implicit modules even when
# the real build succeeds. Parse headers textually for indexing only.
CompileFlags:
  CompilationDatabase: .
  Remove:
    - -fmodules
    - -fcxx-modules
    - -fmodule-name=*
    - -fmodules-*
    - -fbuild-session-file=*
  Add:
    - -fno-modules
    - -fno-implicit-modules
    - -DSH_CLANGD=1
---
# Logos sources have no native compiler extension. Retain Objective-C++ parsing
# even when clangd borrows a command for this file from another database entry.
If:
  PathMatch: '.*\.xm'
CompileFlags:
  Remove: [-x, -std=*]
  Add: [-x, objective-c++, -std=c++17]
